# ============ 模型后端 ============
# demo：不调用大模型，只做本地检索演示（无需 Key，适合快速验收界面）
# openai_compatible：在线兼容 OpenAI 接口的模型，如 DeepSeek、Qwen
# ollama：本地 Ollama 离线模型
LLM_PROVIDER=demo

# 在线模型或离线模型名称；切换提供方时请同步修改
LLM_MODEL=deepseek-chat

# 在线模型接口地址；Ollama 可填 http://127.0.0.1:11434
LLM_BASE_URL=https://api.deepseek.com

# 在线模式必填；不要提交真实 Key
LLM_API_KEY=

# Ollama 离线模式示例（取消注释并替换上面的三行配置）：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:1.5b
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_API_KEY=

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ============ Embedding 与检索 ============
# hashing：零下载的可复现检索；huggingface：可选本地语义 Embedding
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSIONS=1024

DATA_DIR=data/raw
TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=120

APP_TITLE=智学助手
